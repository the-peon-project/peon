#!/bin/bash
config_file="/home/steam/steamcmd/data/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini"
game_user_settings_file="/home/steam/steamcmd/data/Pal/Saved/Config/LinuxServer/GameUserSettings.ini"
savegames_root="/home/steam/steamcmd/data/Pal/Saved/SaveGames/0"
dedicated_name_state_file="/home/steam/config/dedicated_server_name"

resolve_dedicated_server_name(){
    local desired_name=""
    local current_name=""

    if [[ -n $DEDICATEDSERVERNAME ]]; then
        desired_name="$DEDICATEDSERVERNAME"
    elif [[ -f $dedicated_name_state_file ]]; then
        current_name=$(tr -d '\r\n' < "$dedicated_name_state_file")
        [[ -n $current_name ]] && desired_name="$current_name"
    fi

    if [[ -z $desired_name && -d $savegames_root ]]; then
        # Prefer the largest existing world directory to avoid switching to a new empty world.
        desired_name=$(find "$savegames_root" -mindepth 1 -maxdepth 1 -type d -printf '%s %f\n' | sort -nr | head -n1 | awk '{print $2}')
    fi

    if [[ -z $desired_name && -f $game_user_settings_file ]]; then
        current_name=$(grep -E '^DedicatedServerName=' "$game_user_settings_file" | head -n1 | cut -d'=' -f2-)
        [[ -n $current_name ]] && desired_name="$current_name"
    fi

    if [[ -n $desired_name ]]; then
        echo -n "$desired_name" > "$dedicated_name_state_file"
    fi

    echo "$desired_name"
}

pin_dedicated_server_name(){
    local dedicated_name="$1"

    [[ -z $dedicated_name ]] && return 0
    [[ ! -f $game_user_settings_file ]] && return 0

    if grep -q -E '^DedicatedServerName=' "$game_user_settings_file"; then
        sed -i "s/^DedicatedServerName=.*/DedicatedServerName=${dedicated_name}/" "$game_user_settings_file"
    else
        printf '\nDedicatedServerName=%s\n' "$dedicated_name" >> "$game_user_settings_file"
    fi
}

escape_sed_replacement(){
    printf '%s' "$1" | sed -e 's/[&@]/\\&/g'
}

quote_option_value(){
    local value="$1"
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    printf '"%s"' "$value"
}

load_current_option_settings(){
    local option_line=""

    option_line=$(grep -E '^OptionSettings=\(' "$config_file" | head -n1)
    if [[ -z $option_line ]]; then
        CURRENT_OPTION_SETTINGS=""
        return 0
    fi

    CURRENT_OPTION_SETTINGS=${option_line#OptionSettings=(}
    CURRENT_OPTION_SETTINGS=${CURRENT_OPTION_SETTINGS%)}
}

upsert_option_setting(){
    local key="$1"
    local raw_value="$2"
    local escaped_value=""

    escaped_value=$(escape_sed_replacement "$raw_value")

    if [[ "$CURRENT_OPTION_SETTINGS" == *"${key}="* ]]; then
        CURRENT_OPTION_SETTINGS=$(printf '%s' "$CURRENT_OPTION_SETTINGS" | sed -E "s@${key}=(\"[^\"]*\"|[^,)]*)@${key}=${escaped_value}@")
    elif [[ -n $CURRENT_OPTION_SETTINGS ]]; then
        CURRENT_OPTION_SETTINGS+=",${key}=${raw_value}"
    else
        CURRENT_OPTION_SETTINGS="${key}=${raw_value}"
    fi
}

set_option_from_env(){
    local env_key="$1"
    local option_key="$2"
    local value_type="$3"
    local env_value=""
    local formatted_value=""

    env_value="${!env_key}"
    [[ -z $env_value ]] && return 0

    if [[ $value_type == "quoted" ]]; then
        formatted_value=$(quote_option_value "$env_value")
    else
        formatted_value="$env_value"
    fi

    upsert_option_setting "$option_key" "$formatted_value"
}

check_config_file(){
    if [ ! -f "$config_file" ]; then
        echo -n "BUILDING CONFIG FILES" > $STATE_FILE
        ./PalServer.sh -useperfthreads -NoAsyncLoadingThread -UseMultithreadForDS &
        PID=$!
        while [ ! -f "$config_file" ]; do
            sleep 1
        done
        sleep 10
        kill $PID
    fi
}

update_server_settings(){
    load_current_option_settings

    if [[ -z $CURRENT_OPTION_SETTINGS ]]; then
        echo "ERROR: Existing OptionSettings were not found in $config_file" >&2
        return 1
    fi

