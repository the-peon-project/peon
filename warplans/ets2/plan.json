{
    "metadata" : {
        "game_uid"      : "ets2",
        "warcamp"       : "default",
        "version"       : "1.0.0",
        "description"   : "A PEON Euro Truck Simulator 2 dedicated server.",
        "mode"          : "steamcmd",
        "hostname"      : "peon.warcamp.ets2",
        "image"         : "umlatt/steamcmd"
    },
    "ports" : [
            [ { "PORT" : ["27015", "udp"] } ]
    ],
    "environment" : {
        "STEAM_ID"       : "1948160",
        "SERVER_NAME"    : null
    },
    "volumes" : {
        "~!/actions"       : "/actions",
        "~!/data"          : "/home/steam/steamcmd/data",
        "~!/config"        : "/home/steam/config",
        "~!/user"          : "/home/steam/.local/share/Euro Truck Simulator 2"
    }
}
