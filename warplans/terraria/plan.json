{
    "metadata" : {
        "game_uid"      : "terraria",
        "warcamp"       : "default",
        "version"       : "1.0.0",
        "description"   : "A PEON Terraria dedicated server.",
        "mode"          : "steamcmd",
        "hostname"      : "peon.warcamp.terraria",
        "image"         : "umlatt/steamcmd"
    },
    "ports" : [
            [ { "PORT" : ["7777", "tcp"] } ]
    ],
    "environment" : {
        "STEAM_ID"       : "105600",
        "SERVER_NAME"    : null,
        "PASSWORD"       : null
    },
    "volumes" : {
        "~!/actions"       : "/actions",
        "~!/data"          : "/home/steam/steamcmd/data",
        "~!/config"        : "/home/steam/config",
        "~!/user"          : "/home/steam/.local/share/Terraria"
    }
}
