DEV_MODE=disabled
TIMEZONE=Africa/Johannesburg
LANGUAGE=english
COMMAND_PREFIX=!
DOCKER_SOCKET_PATH=/run/docker.sock
PEON_DIRECTORY=/root/peon
PEON_WEBUI_HOST_PORT=80
PEON_CACHE_ENABLED=false
